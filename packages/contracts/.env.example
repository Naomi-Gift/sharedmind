# Deployer wallet (the account that deploys and owns the contract)
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Agent wallet (the backend service wallet)
AGENT_ADDRESS=0xYOUR_AGENT_WALLET_ADDRESS

# Kite chain
KITE_RPC_URL=https://rpc-testnet.gokite.ai
KITE_CHAIN_ID=2368

# Real USDC address on Kite chain (for DeployKite script)
USDC_ADDRESS=0xUSDC_ON_KITE

# Block explorer (for --verify flag)
KITE_EXPLORER_URL=https://explorer-testnet.gokite.ai
KITE_EXPLORER_API_KEY=your_api_key
